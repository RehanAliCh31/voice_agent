# Copy this to .env and fill in what you need. The server reads it on
# startup; .env is gitignored and never committed, which is the whole
# point of there being an example.
#
# Anything already exported in your shell wins, so a file you forgot
# about cannot quietly override what you typed.
#
# Nothing here is required. With none of it the project runs on the
# committed defaults: fake speech, fake model, in-memory bank, offline.

# The key for the model endpoint, if it ever needs one. The variable's
# name is set by `llm.api_key_env` in the config. The endpoint in
# configs/serve.yaml currently accepts requests without a key, so this
# can stay as it is -- an empty value is read as unset, not as a key
# that happens to be blank.
VOICEBOT_LLM_KEY=

# Which configuration to load. Uncomment for the real engines: Whisper,
# the model endpoint, and the bank in PostgreSQL.
# VOICEBOT_CONFIG=configs/serve.yaml

# The hands-free assistant reads configs/assistant.yaml: every endpoint,
# model, voice and threshold. Point this at a copy to use another.
# VOICEBOT_ASSISTANT_CONFIG=configs/assistant.yaml

# The PostgreSQL bank, read when the config says `database.engine: postgres`.
# Host, port and name default to localhost, 5432 and voicebot, so on one
# machine only the user and password are needed. The password is the one
# value that must never be committed -- which is why it lives here and in no
# config file.
VOICEBOT_DB_HOST=localhost
VOICEBOT_DB_PORT=5432
VOICEBOT_DB_NAME=voicebot
VOICEBOT_DB_USER=postgres
VOICEBOT_DB_PASSWORD=
