# Copy to .env and fill in, or export these in the shell before starting.
# Nothing here is read automatically: the server reads the environment, and
# this file exists to say which variables it looks for.

# The key for the model endpoint, if it ever needs one. The name is set by
# `llm.api_key_env` in the config; the endpoint in configs/serve.yaml
# currently accepts requests without a key, so this can stay empty.
VOICEBOT_LLM_KEY=

# Which configuration to load. Unset means the committed defaults, which are
# entirely offline: fake speech, fake model, in-memory bank.
#   configs/serve.yaml  the real engines
# VOICEBOT_CONFIG=configs/serve.yaml
