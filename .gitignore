# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage artefacts. The report is produced on demand and in CI; the
# database behind it is a build product like any other.
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Editors
.vscode/
.idea/

# Data and model artefacts — reproducible, and too large for a repo
data/raw/
data/interim/
data/processed/
data/synthetic/
checkpoints/
results/**/*.json
*.wav
# The listening samples are the one place recordings are committed.
!voice_samples/**/*.wav

# Generated at runtime
*.db
*.sqlite3

# Secrets — never commit
.env
kaggle.json

# The assistant's model files (fetched by `python -m voicebot.assistant
# setup`), what its integration script writes, and microphone audio, which
# is only ever saved with debug.save_audio on.
models/
test-output/
debug_audio/

# Scratch workspace for plan execution
.superpowers/
